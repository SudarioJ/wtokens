# Configuración del Servidor Web
BACKEND_URL=http://127.0.0.1:8080
PORT=3000
HOST=127.0.0.1

# 🤖 Configuración del Bot Oficial de Discord de WTOKENS
# Obtenidos de Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=tu_token_secreto_del_bot_aqui
DISCORD_CLIENT_ID=tu_application_client_id_aqui

# 🏰 IDs de tu Servidor de Discord (Clic derecho en Discord -> "Copiar ID")
DISCORD_GUILD_ID=id_de_tu_servidor_de_discord

# 🛡️ Roles del Servidor
DISCORD_STAFF_ROLE_ID=id_del_rol_de_staff_o_moderador
DISCORD_VERIFIED_ROLE_ID=id_del_rol_verificado
DISCORD_IN_DUEL_ROLE_ID=id_del_rol_en_duelo
DISCORD_CREATOR_ROLE_ID=id_del_rol_creador_15
DISCORD_CREATOR_PLUS_ROLE_ID=id_del_rol_creator_plus_20

# 📢 Canales y Categorías de Discord
# Categoría donde se crean las salas temporales de duelos 1v1
DISCORD_DUEL_CATEGORY_ID=id_de_categoria_duelos_activos
# Canal público donde el bot anuncia los ganadores ("🔥 K1ng venció a Vortex...")
DISCORD_RESULTS_CHANNEL_ID=id_del_canal_duelos_completados
# Canal privado donde el bot avisa cuando un jugador pide árbitro o hay disputa
DISCORD_STAFF_ALERTS_CHANNEL_ID=id_del_canal_alertas_staff
# Canal privado donde llegan las solicitudes para ser Creador
DISCORD_AFFILIATES_CHANNEL_ID=id_del_canal_solicitudes_creador

# 🎮 Epic Games Developer Portal (Epic Online Services / Epic Account Services)
# Obtenidos de https://dev.epicgames.com/portal/ (Product Settings -> Clients)
VITE_EPIC_CLIENT_ID=tu_epic_client_id_aqui
EPIC_CLIENT_ID=tu_epic_client_id_aqui
EPIC_CLIENT_SECRET=tu_epic_client_secret_aqui
